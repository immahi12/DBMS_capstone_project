# ReLoop Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=reloop_db
DB_USER=reloop_admin
DB_PASSWORD=your_secure_postgres_password_here
DB_MAX_POOL=20

# Authentication
JWT_SECRET=replace_with_a_strong_256_bit_secret_key
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10
